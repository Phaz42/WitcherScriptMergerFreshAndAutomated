<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <CodeAnalysisRuleSet></CodeAnalysisRuleSet>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>WolfMedallion.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!--Prevent
    app.config being copied to output directory-->
    <None Remove="app.config" />
    <Resource Include="app.config" CopyToOutputDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\ConflictTree.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\MergeTree.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Controls\SMTree.cs">
      <SubType>Component</SubType>
    </Compile>
    <Compile Update="Forms\BaseForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\DependencyForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MergeReportForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\MessageForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\OptionsForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\PackReportForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Forms\PriorityPromptForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Content Include="WolfMedallion.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- The "no conflicts" images ship as files, never as resources, so a user can replace them: their own go in
         Images\Custom, where a release puts only its README (Theming\NoConflictsImage.cs). -->
    <None Update="Images\Default\No-Conflicts-Dark.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Images\Default\No-Conflicts-Light.png" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Images\Custom\README.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.421302">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="9.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="9.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- The QuickBMS script, with its 5.x bundle branch, ships in Tools\QuickBMS beside the released tools. -->
    <None Update="Tools\QuickBMS\witcher3.bms" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <AssemblyVersion>$(PackageVersion)</AssemblyVersion>
    <Version>1.0.0</Version>
    <PackageProjectUrl>https://www.nexusmods.com/witcher3/mods/8405</PackageProjectUrl>
    <Title>Script Merger - Fresh and Automated Edition (SM-FAE)</Title>
    <Description>Script Merger - Fresh and Automated Edition (SM-FAE)</Description>
    <Copyright>Script Merger - Fresh and Automated Edition (SM-FAE)</Copyright>
    <RepositoryUrl>https://github.com/Phaz42/WitcherScriptMergerFreshAndAutomated</RepositoryUrl>
    <FileVersion>$(PackageVersion)</FileVersion>
    <Authors>$(AssemblyName)FAE</Authors>
    <Product>Script Merger - Fresh and Automated Edition (SM-FAE)</Product>
    <PackageId>$(AssemblyName)FAE</PackageId>
    <NeutralLanguage>en-US</NeutralLanguage>
    <AnalysisLevel>6.0-all</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <NoWarn />
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <NoWarn />
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>